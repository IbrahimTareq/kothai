{
  // Temporary. Holds the checkJs coverage 91d9290 added for server/lib while
  // the TypeScript migration converts those seven files to .ts in waves 0-1.
  // Its include glob empties itself as each file is renamed; wave 1 deletes
  // this file once server/lib is fully .ts. Do not add anything to it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // http.js and ssrf.js import '../config.ts' now that wave 0b renamed it.
    // Without this, tsc fails them with TS5097 ("an import path can only end
    // with a '.ts' extension when 'allowImportingTsExtensions' is enabled") —
    // the same flag the other two configs already carry, and safe for the same
    // reason: noEmit is on, so no .ts specifier is ever written into output.
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["server/lib/**/*.js"]
}

# Railway-compatible image — the same server and client as Dockerfile.
# No cache mounts (Railway needs service-specific IDs) and no VOLUME
# declarations (Railway manages volumes via its dashboard).
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS client
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/api/package.json ./packages/api/package.json
RUN pnpm install --frozen-lockfile
COPY tsconfig.json vite.config.ts index.html ./
COPY client ./client
COPY packages/api/src ./packages/api/src
COPY public ./public
RUN pnpm run build:client

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/api/package.json ./packages/api/package.json
RUN pnpm install --prod --frozen-lockfile
COPY server ./server
COPY docker/entrypoint.ts ./docker/entrypoint.ts
COPY --from=client /app/dist ./dist
RUN chown node:node /app

ENV PORT=5173
ENV KOTHAI_HOME=/app/data
EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5173)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "docker/entrypoint.ts"]

{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,

    // Node strips types at load; nothing here is ever compiled. These three are
    // what make that safe.
    //
    // allowImportingTsExtensions: relative imports carry explicit .ts, the only
    // form node's stripper resolves with no build step in between.
    //
    // erasableSyntaxOnly: enum/namespace/parameter properties are NOT erasable.
    // Node throws ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX on them at load — before any
    // test body runs, so no test in this repo would catch it.
    //
    // verbatimModuleSyntax: node cannot tell a type import from a value import.
    // `import { SomeType }` without the `type` keyword survives stripping and
    // dies at load with "does not provide an export named". This flag is the
    // only thing that turns that boot failure into a typecheck error.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // test/scripts/ is listed explicitly because it matches no other pattern:
  // it is not under test/server/, and tsconfig.json covers only client and
  // test/client. A renamed-but-unincluded test still RUNS, so the suite stays
  // green while nothing typechecks it — the same silent gap tsconfig.json
  // records for test/client, which reached 18 files and 54 errors before
  // anyone noticed on 2026-09-17.
  "include": [
    "server/**/*.ts",
    "test/server/**/*.ts",
    "test/helpers/**/*.ts",
    "test/scripts/**/*.ts",
    "scripts/**/*.ts",
    "docker/**/*.ts"
  ]
}

{
  "name": "kothai",
  "version": "1.3.0",
  "description": "Kothai every thought, picture, link or file",
  "main": "server/index.ts",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"node server/index.ts\" \"vite\"",
    "build": "biome check . && node scripts/lint-tokens.ts && pnpm run typecheck && vite build",
    "start": "npm run build && node server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "biome check . && node scripts/lint-tokens.ts && node scripts/lint-shape.ts && node --experimental-test-module-mocks --test 'test/**/*.test.js' 'test/**/*.test.ts'",
    "lint:tokens": "node scripts/lint-tokens.ts",
    "lint:shape": "node scripts/lint-shape.ts",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/IbrahimTareq/kothai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbrahimTareq/kothai.git"
  },
  "bugs": {
    "url": "https://github.com/IbrahimTareq/kothai/issues"
  },
  "dependencies": {
    "@extractus/oembed-extractor": "^6.0.0",
    "@mozilla/readability": "^0.6.0",
    "@qvac/sdk": "^0.12.0",
    "@xyflow/react": "^12.11.3",
    "linkedom": "^0.18.13",
    "require-asset": "^1.2.2",
    "youtube-transcript": "^1.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@qvac/onnx": "0.15.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
